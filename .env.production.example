# Kidnap-children v2 - production environment for docker-compose.prod.yml.
# Fill it with:  python3 scripts/gen-prod-env.py <app-domain> <files-domain>
# Never commit .env.production.

# ── public addresses (Caddy) ──────────────────────────────────────────────
# Site address of the app. A bare domain gets automatic HTTPS (Let's Encrypt);
# DNS A/AAAA records must point at this server and ports 80/443 must be open.
SITE_ADDRESS=app.example.org
# Address that presigned file URLs point to (bundled S3 store behind Caddy).
# With an external bucket nothing is served here; use http://files.invalid
FILES_ADDRESS=files.example.org
# Contact e-mail for Let's Encrypt.
ACME_EMAIL=admin@example.org
# Host ports Caddy binds (change only for testing).
HTTP_PORT=80
HTTPS_PORT=443

# Full public URL of the app (CORS origin, links in e-mails, allowed origin for browser uploads).
PUBLIC_WEB_URL=https://app.example.org

# ── database (bundled postgres) ───────────────────────────────────────────
POSTGRES_DB=kidnap
POSTGRES_USER=kidnap
# Long random value.
POSTGRES_PASSWORD=__generate__

# ── auth ──────────────────────────────────────────────────────────────────
# Long random value (>= 32 chars). Changing it logs everybody out.
JWT_SECRET=__generate__
JWT_TTL_MINUTES=720

# ── object storage (S3-compatible) ────────────────────────────────────────
# Bundled store: keep COMPOSE_PROFILES=bundled-s3, S3_ENDPOINT=http://s3:8333 and
# S3_PUBLIC_ENDPOINT=https://<FILES_ADDRESS>.
# External bucket (AWS S3, Cloudflare R2, Wasabi, MinIO elsewhere): set COMPOSE_PROFILES=
# (empty), S3_ENDPOINT/S3_PUBLIC_ENDPOINT to the provider endpoint (empty S3_ENDPOINT = AWS),
# a private bucket, and CORS on the bucket allowing PUT, GET, HEAD from PUBLIC_WEB_URL.
COMPOSE_PROFILES=bundled-s3
S3_ENDPOINT=http://s3:8333
S3_PUBLIC_ENDPOINT=https://files.example.org
S3_REGION=us-east-1
S3_BUCKET=kidnap-media
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=__generate__
S3_SECRET_KEY=__generate__
# Lifetime of presigned URLs in seconds.
UPLOAD_URL_TTL_SECONDS=300
DOWNLOAD_URL_TTL_SECONDS=300

# ── first admin (optional) ────────────────────────────────────────────────
# Register this account in the app, then promote it:
#   docker compose -f docker-compose.prod.yml --env-file .env.production exec postgres \
#     psql -U kidnap -d kidnap -c "update users set role='admin', token_version=token_version+1 where email='...'"
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# ── optional integrations (off when empty) ────────────────────────────────
# Forward report/match events to an n8n webhook, signed with HMAC-SHA256 (X-Signature-256).
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Reverse geocoding for map pins. Use a NEW key restricted to the Geocoding API.
GOOGLE_MAPS_API_KEY=

# Image tag for kidnap-children/backend and kidnap-children/web.
IMAGE_TAG=latest
