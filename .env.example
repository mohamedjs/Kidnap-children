# Create .env with scripts/gen-dev-env.sh (fills the secrets with random values). Never commit .env.

# ── infra (docker-compose.yml) ──
POSTGRES_DB=kidnap
POSTGRES_USER=kidnap
POSTGRES_PASSWORD=__generate__
POSTGRES_PORT=5435
S3_PORT=9010
S3_ACCESS_KEY=__generate__
S3_SECRET_KEY=__generate__
S3_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# ── backend ──
APP_ENV=development
API_PORT=4100
DATABASE_URL=postgresql+psycopg://kidnap:__POSTGRES_PASSWORD__@127.0.0.1:5435/kidnap
JWT_SECRET=__generate__
JWT_TTL_MINUTES=720
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
PUBLIC_WEB_URL=http://localhost:3100

# S3-compatible storage.
#   S3_ENDPOINT         what the api/worker use to reach the bucket (empty = AWS default)
#   S3_PUBLIC_ENDPOINT  the host the browser sees; presigned URLs are signed for it
S3_ENDPOINT=http://127.0.0.1:9010
S3_PUBLIC_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=kidnap-media
S3_FORCE_PATH_STYLE=true
UPLOAD_URL_TTL_SECONDS=300
DOWNLOAD_URL_TTL_SECONDS=300

# first admin (created by the seed when no admin exists)
ADMIN_SEED_EMAIL=admin@demo.local
ADMIN_SEED_PASSWORD=__generate__

# optional integrations (off when empty)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=
